note() {
    printf "\033[1;34m==>\033[1;33m NOTE:\033[1m $1\033[0m\n"
}

post_install() {
    echo ""
    note "Run 'unsloth-studio' to start the setup + web UI."
    note "First run will create a venv and install PyTorch + unsloth (~2GB+)."
    note "Re-run installer anytime: bash /opt/unsloth/install.sh"
    echo ""
}

post_upgrade() {
    post_install
}
